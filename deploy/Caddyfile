# Public front. Only these paths exist; the Sable apps themselves are never exposed here.
{$FRONT_DOMAIN} {
	encode zstd gzip
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Robots-Tag "noindex, nofollow"
		Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; frame-ancestors 'none'"
	}

	# Person A: webhooks only.
	handle_path /{$SLUG_A}/hooks/* {
		rewrite * /hooks{uri}
		reverse_proxy sable-a:8788
	}

	# Person B: webhooks only.
	handle_path /{$SLUG_B}/hooks/* {
		rewrite * /hooks{uri}
		reverse_proxy sable-b:8788
	}

	# Everything else: a blank page served by Caddy itself. Nothing else reaches the Sable containers.
	handle / {
		header Content-Type "text/html; charset=utf-8"
		respond "<!doctype html><html lang=en><head><meta charset=utf-8><meta name=viewport content='width=device-width,initial-scale=1'><meta name=robots content=noindex><title>{$FRONT_TITLE}</title><style>html,body{height:100%;margin:0}body{display:flex;align-items:center;justify-content:center;background:#0f0f11;color:#a0a0a8;font:15px/1.5 system-ui,sans-serif}</style></head><body><p>{$FRONT_TITLE}</p></body></html>" 200
	}
	handle /robots.txt {
		respond "User-agent: *
Disallow: /
" 200
	}
	handle {
		respond "Not found" 404
	}
}
