# gluetun settings: https://github.com/qdm12/gluetun-wiki
# Pick your provider and fill in its WireGuard (recommended) or OpenVPN details.

VPN_SERVICE_PROVIDER=mullvad
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
SERVER_COUNTRIES=Sweden

# OpenVPN instead:
# VPN_TYPE=openvpn
# OPENVPN_USER=
# OPENVPN_PASSWORD=
